# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 排除，不会入库）
# API key 也可直接设置环境变量 AGENT_API_KEY 或 DEEPSEEK_API_KEY

AGENT_API_KEY=sk-xxxxxxxxxxxxxxxx
AGENT_MODEL=deepseek-chat
AGENT_BASE_URL=https://api.deepseek.com

# 可选调优项
# AGENT_TEMPERATURE=0.0
# AGENT_MAX_TOKENS=4096
# AGENT_MAX_CONTEXT_TOKENS=56000
# AGENT_MAX_STEPS=30
# AGENT_TIMEOUT=120
